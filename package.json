{
  "name": "focusmate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test src/*.test.ts server/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:pages": "tsc -b && vite build --mode pages"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT"
}
